NODE_ENV=development
PORT=3000

NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_DOMAIN=ratamaekata.gov.lk
NEXT_PUBLIC_API_BASE_URL=/api

# Target Python backend for local development (defaults to local http://127.0.0.1:8000):
# If you want to run frontend locally and connect directly to the deployed Vercel cloud backend, uncomment:
# API_BASE_URL=https://api-delta-one-54.vercel.app

NEXT_PUBLIC_HOTLINE_1818=1818
NEXT_PUBLIC_HOTLINE_1927=1927

NEXT_PUBLIC_DEFAULT_LOCALE=en
NEXT_PUBLIC_SUPPORTED_LOCALES=en,si,ta

